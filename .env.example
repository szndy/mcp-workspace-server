# Copy this file to .env and fill it in. .env is git-ignored.
# Use SINGLE quotes around Windows paths: they contain spaces, brackets and '#'
# which would otherwise be read as a comment or an escape sequence.

PORT=3000

# Folder the file tools are allowed to touch (everything outside is rejected).
WORKSPACE_ROOT='./workspace'

# How many folder levels below WORKSPACE_ROOT to scan for git repositories.
SCAN_DEPTH=3

# Excel masterlist (optional). Only this one file is reachable by the masterlist tools.
MASTERLIST_PATH=''
# Copy of the masterlist is saved here before every change.
BACKUP_DIR='./backups'

# Generate each with:  npm run token
# ADMIN_TOKEN gets every tool. READER_TOKEN (optional) gets read-only tools.
ADMIN_TOKEN=
READER_TOKEN=

# Optional. Fine-grained GitHub token with read-only access to Contents, Issues
# and Pull requests on the repositories you want summarised.
GITHUB_TOKEN=

# Optional. Only used by ecosystem.config.cjs to start the ngrok tunnel under pm2.
# Your reserved ngrok domain, e.g. my-name.ngrok-free.app
NGROK_DOMAIN=
