# Copy to .env and fill in. .env is git-ignored.
# Single-quote Windows paths: an unquoted '#' starts a comment and '\' can be read as an escape.

PORT=3000

# Folder the file and git tools may touch.
WORKSPACE_ROOT='./workspace'

# Folder levels below WORKSPACE_ROOT to scan for git repositories.
SCAN_DEPTH=3

# Optional. The one .xlsx file the masterlist tools may open.
MASTERLIST_PATH=''
# The masterlist is copied here before every change.
BACKUP_DIR='./backups'

# Generate each with: npm run token. ADMIN_TOKEN gets every tool; READER_TOKEN (optional) only read-only tools.
ADMIN_TOKEN=
READER_TOKEN=

# Optional. Fine-grained GitHub token with read access to Contents, Issues and Pull requests.
GITHUB_TOKEN=

# Optional. Your ngrok static domain, e.g. <your-domain>. Free accounts get one ending in .ngrok-free.dev. pm2 starts the tunnel when set.
NGROK_DOMAIN=
